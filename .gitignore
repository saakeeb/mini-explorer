# =========================================================
# Next.js 16 + React 19 + TypeScript + Turbopack
# Production-ready .gitignore
# =========================================================

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production build
dist/
build/

# Turbopack cache
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# TypeScript
*.tsbuildinfo

# Coverage / Testing
coverage/
.nyc_output/

# ESLint cache
.eslintcache

# Package manager cache
.pnpm-store/
.yarn/
.parcel-cache/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker (optional local files)
docker-compose.override.yml

# Temporary files
tmp/
temp/
.cache/

# AI Agent instruction files (Next.js 16 auto-generates these)
AGENTS.md
CLAUDE.md
GEMINI.md
COPILOT.md

# Claude Code / Cursor artifacts
.claude/
.cursor/
.cursor-cache/

# Misc
.vercel/